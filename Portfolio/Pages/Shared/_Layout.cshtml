<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Portfolio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Portfolio.styles.css" asp-append-version="true"/>
</head>
<body>
<header class="topo">
    <div class="container topo__conteudo">
        <a class="topo__marca" asp-page="/Index">Simone Da Silva</a>
        <nav class="topo__menu" aria-label="Principal">
            <a asp-page="/Index">Home</a>
            <a asp-page="/Projetos/Index">Projetos</a>
            <a asp-page="/Sobre">Sobre</a>
            <a asp-page="/Contato">Contato</a>
        </nav>
    </div>
</header>

<div class="container">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="rodape">
    <div class="container">&copy; 2026 Simone Da Silva · Brasil, BR</div>
</footer>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">

</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>